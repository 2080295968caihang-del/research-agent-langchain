# 复制为 .env 后填写配置。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

SEARCH_PROVIDER=bocha
SEARCH_API_KEY=

SEARCH_TOP_K=5
SEARCH_TIMEOUT=10
SEARCH_MAX_RETRIES=2

# 第 7b 天：模型超时与日志
OPENAI_TIMEOUT=60
OPENAI_MAX_RETRIES=2
LOG_LEVEL=INFO
LOG_FILE=

# 第 9 天：单价（元 / 百万 token）。留空则 estimated_cost_cny 为 null，不按 0 算。
# 缓存价单独一档；不填则按标准输入价估算（偏高估）。
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=
PRICE_CACHE_READ_PER_M=
