# 复制为 .env 后填写配置。
# .env 会被 .gitignore 忽略，真实 API Key 不要提交到 Git。

# ---------- 大模型（第 1 天） ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ---------- 搜索服务（第 3 天） ----------
# 可选值：tavily（国际，英文强）或 bocha（国内，中文强）
SEARCH_PROVIDER=tavily

# 搜索服务的 Key。Tavily 形如 tvly-xxxx，博查形如 sk-xxxx。
# 注意：这个 Key 和大模型的 OPENAI_API_KEY 不是一回事，不要填混。
SEARCH_API_KEY=

# 每次返回几条结果，程序内部会限制在 1~10
SEARCH_TOP_K=5

# 单次请求最多等几秒
SEARCH_TIMEOUT=10

# 失败后重试几次（总共尝试次数 = 这个值 + 1）
SEARCH_MAX_RETRIES=2
