# 复制为 .env 后填写配置。
# .env 会被 .gitignore 忽略，真实 API Key 不要提交到 Git。

# ---------- 大模型（第 1 天） ----------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# ---------- 搜索服务（第 3 天） ----------
# 可选值：tavily（国际，英文强）或 bocha（国内，中文强）
SEARCH_PROVIDER=tavily

# 搜索服务的 Key。Tavily 形如 tvly-xxxx，博查形如 sk-xxxx。
# 注意：这个 Key 和大模型的 OPENAI_API_KEY 不是一回事，不要填混。
SEARCH_API_KEY=

# 每次返回几条结果，程序内部会限制在 1~10
SEARCH_TOP_K=5

# 单次请求最多等几秒
SEARCH_TIMEOUT=10

# 失败后重试几次（总共尝试次数 = 这个值 + 1）
SEARCH_MAX_RETRIES=2

# ---------- 模型超时（第 7b 天） ----------
# 单次模型调用最多等几秒。原先是代码里写死 60，换代理/换模型时不用改代码。
OPENAI_TIMEOUT=60

# 模型调用失败后重试几次（总共尝试次数 = 这个值 + 1）
OPENAI_MAX_RETRIES=2

# ---------- 日志（第 7b 天） ----------
# 级别：DEBUG / INFO / WARNING / ERROR，也接受数字（如 20）。留空默认 INFO。
LOG_LEVEL=INFO

# 日志文件路径。留空则只输出到终端、不写磁盘。
# 目录不存在会自动创建；目录不可写时静默降级为只输出终端。
LOG_FILE=

# ---------- 单价（第 9 天） ----------
# 单位是「元 / 百万 token」，不是「元 / token」，也不是美元。
# 三个都留空时 estimated_cost_cny 返回 null —— 不要填 0，0 会被读成「免费」。
PRICE_INPUT_PER_M=
PRICE_OUTPUT_PER_M=

# 缓存命中价的单独档位。留空则按 PRICE_INPUT_PER_M 估算，结果偏高估。
# OpenAI 系的缓存价通常是标准价的 1/10 左右，能填就填。
PRICE_CACHE_READ_PER_M=
